{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "git-notes",
  "version": "../package.json",
  "identifier": "com.ylkhn.gitnotes",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "git-notes",
        "width": 1200,
        "height": 800,
        "minWidth": 480,
        "minHeight": 320,
        "center": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost notebook: http://notebook.localhost data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Git-backed Markdown notes",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 26
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNEODE0NUZENThFRENDOUUKUldTZXpPMVkvVVdCUFNCS2djQWY3ZThhbzR2N2ZBWHRROW5YKzlFcjdIWE1EMGhoL1VwN01FN00K",
      "endpoints": ["https://github.com/ylkhn1/git-notes/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
