{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Desktop-only plugins: window geometry persistence, in-app updates, paste from the editor menu",
  "platforms": ["linux", "windows", "macOS"],
  "windows": ["main"],
  "permissions": [
    "window-state:default",
    "updater:default",
    "process:allow-restart",
    "clipboard-manager:allow-read-text"
  ]
}
